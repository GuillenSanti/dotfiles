#!/bin/sh
# Stops a commit that would put a secret, a path into your home folder, or a word of your private setup
# in the repo (gitleaks, with private/gitleaks.toml when there's one, else .gitleaks.toml)
if ! command -v gitleaks >/dev/null 2>&1; then
    echo "pre-commit: commit blocked because gitleaks is missing. Install it with brew install gitleaks, then retry." >&2
    exit 1
fi
config=.gitleaks.toml
[ -f private/gitleaks.toml ] && config=private/gitleaks.toml
exec gitleaks git --pre-commit --staged --config "$config" --no-banner --redact
